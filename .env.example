# Mode local hors ligne. Ne jamais versionner .env.
DATABASE_URL=sqlite:///./goldmaking.db
# Avec PostgreSQL local : postgresql+psycopg://goldmaking:local-dev-only@localhost:5432/goldmaking
LOG_LEVEL=INFO
MAX_DOWNLOAD_BYTES=33554432
MAX_CSV_ROWS=500000
HTTP_TIMEOUT_SECONDS=30
HTTP_ATTEMPTS=3
# Vérifications HTTP conditionnelles, sans téléchargement si le fichier est inchangé.
TSM_PRIMARY_INTERVAL_SECONDS=1800
TSM_MARKET_INTERVAL_SECONDS=3600
TSM_REGION_INTERVAL_SECONDS=10800
# Cadences amont estimées utilisées pour calculer la fraîcheur des scans.
TSM_MARKET_PUBLICATION_SECONDS=10800
TSM_REGION_PUBLICATION_SECONDS=86400
# Compose uniquement ; changer avant toute exposition réseau.
POSTGRES_PASSWORD=local-dev-only
